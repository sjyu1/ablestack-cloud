[Unit]
Description=ABLESTACK Storage Service boot reconcile
After=local-fs.target network-online.target qemu-guest-agent.service
Wants=network-online.target
Before=ablestack-storage-monitor.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ablestack-storage-boot-reconcile
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
