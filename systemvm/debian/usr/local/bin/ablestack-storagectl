set -euo pipefail

LOG_FILE="/var/log/ablestack-storagectl.log"

json_escape() {
  local value="${1:-}"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  printf '%s' "$value"
}

emit_success() {
  local message="$1"
  printf '{"success":true,"message":"%s"}\n' "$(json_escape "$message")"
}

emit_error() {
  local message="$1"
  printf '{"success":false,"message":"%s"}\n' "$(json_escape "$message")" >&2
}

log_command() {
  mkdir -p "$(dirname "$LOG_FILE")"
  printf '%s command=%s payload=%s\n' "$(date -Is)" "${1:-}" "${2:-}" >> "$LOG_FILE"
}

apply_nfs_exports() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import re
import sys

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

exports_dir = "/etc/exports.d"
quota_dir = "/etc/ablestack-storage"
os.makedirs(exports_dir, exist_ok=True)
os.makedirs(quota_dir, exist_ok=True)

def truth(config, key, default):
    value = config.get(key, default) if isinstance(config, dict) else default
    return bool(value)

def safe_uuid(value):
    value = str(value or "")
    if not re.match(r"^[A-Za-z0-9_.-]+$", value):
        raise ValueError(f"invalid export uuid: {value}")
    return value

quota_state = {}
managed_files = set()
enabled = bool(payload.get("enabled", True))

for export in payload.get("exports", []):
    uuid = safe_uuid(export.get("uuid"))
    export_file = os.path.join(exports_dir, f"ablestack-{uuid}.exports")
    managed_files.add(export_file)
    path = export.get("path")
    state = export.get("state", "Ready")
    lines = []
    if enabled and path and state not in ("Disabled", "Destroyed", "Error"):
        os.makedirs(path, exist_ok=True)
        export_config = export.get("config") or {}
        for acl in export.get("acls", []):
            acl_state = acl.get("state", "Ready")
            if acl_state in ("Disabled", "Destroyed", "Error"):
                continue
            principal = acl.get("principal")
            if not principal:
                continue
            permission = acl.get("permission", "READ_ONLY")
            acl_config = acl.get("config") or {}
            read_write = "rw" if permission == "READ_WRITE" and not truth(export_config, "readOnly", False) else "ro"
            root_squash = "root_squash" if truth(acl_config, "rootSquash", truth(export_config, "rootSquash", True)) else "no_root_squash"
            sync = "sync" if truth(acl_config, "sync", truth(export_config, "sync", True)) else "async"
            secure = "secure" if truth(acl_config, "secure", truth(export_config, "secure", True)) else "insecure"
            options = ",".join([read_write, sync, root_squash, secure, "no_subtree_check"])
            lines.append(f"{path} {principal}({options})")
        if export.get("quotaBytes") is not None:
            quota_state[uuid] = {
                "path": path,
                "quotaBytes": export.get("quotaBytes"),
                "filesystem": export.get("filesystem"),
            }
    with open(export_file, "w", encoding="utf-8") as export_fp:
        if lines:
            export_fp.write("\n".join(lines) + "\n")

for name in os.listdir(exports_dir):
    if name.startswith("ablestack-") and name.endswith(".exports"):
        full_path = os.path.join(exports_dir, name)
        if full_path not in managed_files:
            with open(full_path, "w", encoding="utf-8"):
                pass

with open(os.path.join(quota_dir, "nfs-quotas.json"), "w", encoding="utf-8") as quota_fp:
    json.dump(quota_state, quota_fp, sort_keys=True, indent=2)

print(json.dumps({"success": True, "exports": len(payload.get("exports", [])), "quotas": len(quota_state)}))
PY

  if command -v systemctl >/dev/null 2>&1; then
    systemctl enable --now nfs-server >/dev/null 2>&1 || systemctl enable --now nfs-kernel-server >/dev/null 2>&1 || true
  fi
  exportfs -ra
}

apply_smb_shares() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import pwd
import re
import subprocess
import sys

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

state_dir = "/etc/ablestack-storage"
os.makedirs(state_dir, exist_ok=True)

def truth(config, key, default):
    value = config.get(key, default) if isinstance(config, dict) else default
    return bool(value)

def safe_share_name(value):
    value = str(value or "")
    if not re.match(r"^[A-Za-z0-9_.-]+$", value):
        raise ValueError(f"invalid SMB share name: {value}")
    return value

def smb_identity(value):
    value = str(value or "")
    if not value:
        return ""
    if value.startswith("@"):
        return value
    return value.replace("/", "\\")

def smb_group(value):
    value = smb_identity(value)
    return value if value.startswith("@") else f"@{value}"

def ensure_local_smb_user(user, password):
    if not user or not password:
        return
    try:
        pwd.getpwnam(user)
    except KeyError:
        subprocess.run(["useradd", "-M", "-s", "/usr/sbin/nologin", user], check=True)
    subprocess.run(["smbpasswd", "-s", "-a", user], input=f"{password}\n{password}\n", text=True, check=True)
    subprocess.run(["smbpasswd", "-e", user], check=True)

identity = payload.get("identityDomain") or {}
identity_config = identity.get("config") or {}
domain_name = identity.get("domainName")
join_state = identity.get("joinState")
workgroup = identity_config.get("workgroup") or "WORKGROUP"
ad_joined = bool(domain_name and join_state == "JOINED")

lines = [
    "[global]",
    "   server string = ABLESTACK Storage Service",
    "   load printers = no",
    "   printing = bsd",
    "   disable spoolss = yes",
    "   map to guest = Bad User",
    "   passdb backend = tdbsam",
]
if ad_joined:
    lines.extend([
        f"   workgroup = {workgroup}",
        f"   realm = {domain_name.upper()}",
        "   security = ADS",
        "   kerberos method = secrets and keytab",
        "   winbind use default domain = yes",
        "   winbind enum users = yes",
        "   winbind enum groups = yes",
    ])
else:
    lines.extend([
        f"   workgroup = {workgroup}",
        "   security = user",
    ])

quota_state = {}
enabled = bool(payload.get("enabled", True))
for share in payload.get("shares", []):
    name = safe_share_name(share.get("name") or share.get("uuid"))
    path = share.get("path")
    state = share.get("state", "Ready")
    if not enabled or not path or state in ("Disabled", "Destroyed", "Error"):
        continue
    os.makedirs(path, exist_ok=True)
    config = share.get("config") or {}
    valid_users = []
    write_list = []
    admin_users = []
    for acl in share.get("acls", []):
        if acl.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        principal = acl.get("principal")
        if not principal:
            continue
        principal_type = acl.get("principalType")
        if principal_type == "LOCAL_USER" and acl.get("password"):
            ensure_local_smb_user(principal, acl.get("password"))
        smb_principal = smb_group(principal) if principal_type in ("LOCAL_GROUP", "AD_GROUP") else smb_identity(principal)
        permission = acl.get("permission", "READ_ONLY")
        valid_users.append(smb_principal)
        if permission in ("READ_WRITE", "ADMIN"):
            write_list.append(smb_principal)
        if permission == "ADMIN":
            admin_users.append(smb_principal)

    lines.extend([
        "",
        f"[{name}]",
        f"   path = {path}",
        f"   read only = {'yes' if truth(config, 'readOnly', False) else 'no'}",
        f"   browseable = {'yes' if truth(config, 'browseable', True) else 'no'}",
        f"   guest ok = {'yes' if truth(config, 'guestOk', False) else 'no'}",
        "   create mask = 0660",
        "   directory mask = 0770",
    ])
    if valid_users:
        lines.append("   valid users = " + " ".join(valid_users))
    if write_list:
        lines.append("   write list = " + " ".join(write_list))
    if admin_users:
        lines.append("   admin users = " + " ".join(admin_users))
    if share.get("quotaBytes") is not None:
        quota_state[str(share.get("uuid"))] = {
            "path": path,
            "quotaBytes": share.get("quotaBytes"),
            "filesystem": share.get("filesystem"),
        }

with open("/etc/samba/smb.conf", "w", encoding="utf-8") as smb_fp:
    smb_fp.write("\n".join(lines) + "\n")

with open(os.path.join(state_dir, "smb-quotas.json"), "w", encoding="utf-8") as quota_fp:
    json.dump(quota_state, quota_fp, sort_keys=True, indent=2)

subprocess.run(["testparm", "-s"], stdout=subprocess.DEVNULL, check=True)
print(json.dumps({"success": True, "shares": len(payload.get("shares", [])), "quotas": len(quota_state), "adJoined": ad_joined}))
PY

  if command -v systemctl >/dev/null 2>&1; then
    systemctl enable --now smbd >/dev/null 2>&1 || true
    systemctl enable --now nmbd >/dev/null 2>&1 || true
    systemctl restart smbd >/dev/null 2>&1 || true
    systemctl restart nmbd >/dev/null 2>&1 || true
    systemctl restart winbind >/dev/null 2>&1 || true
  fi
}

smb_domain_join() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import subprocess
import sys

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

state_dir = "/etc/ablestack-storage"
os.makedirs(state_dir, exist_ok=True)

domain = payload.get("domainName")
username = payload.get("username")
password = payload.get("password")
ou = payload.get("organizationalUnit")
dns_servers = payload.get("dnsServers")
config = payload.get("config") or {}
workgroup = config.get("workgroup") or "WORKGROUP"

if not domain or not username or not password:
    raise SystemExit("domainName, username, and password are required for SMB domain join")

lines = [
    "[global]",
    "   server string = ABLESTACK Storage Service",
    f"   workgroup = {workgroup}",
    f"   realm = {domain.upper()}",
    "   security = ADS",
    "   kerberos method = secrets and keytab",
    "   winbind use default domain = yes",
    "   winbind enum users = yes",
    "   winbind enum groups = yes",
    "   load printers = no",
    "   printing = bsd",
    "   disable spoolss = yes",
    "   map to guest = Bad User",
]
with open("/etc/samba/smb.conf", "w", encoding="utf-8") as smb_fp:
    smb_fp.write("\n".join(lines) + "\n")

if dns_servers:
    with open(os.path.join(state_dir, "smb-dns-servers"), "w", encoding="utf-8") as dns_fp:
        dns_fp.write(str(dns_servers) + "\n")

cmd = ["net", "ads", "join", "-U", f"{username}%{password}"]
if ou:
    cmd.append(f"createcomputer={ou}")
subprocess.run(cmd, check=True)

with open(os.path.join(state_dir, "smb-domain.json"), "w", encoding="utf-8") as state_fp:
    json.dump({"domainName": domain, "organizationalUnit": ou, "dnsServers": dns_servers, "workgroup": workgroup}, state_fp, sort_keys=True, indent=2)

print(json.dumps({"success": True, "domainName": domain}))
PY

  if command -v systemctl >/dev/null 2>&1; then
    systemctl enable --now smbd >/dev/null 2>&1 || true
    systemctl enable --now winbind >/dev/null 2>&1 || true
    systemctl restart smbd >/dev/null 2>&1 || true
    systemctl restart winbind >/dev/null 2>&1 || true
  fi
}

smb_domain_leave() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import subprocess
import sys

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

username = payload.get("username")
password = payload.get("password")
cmd = ["net", "ads", "leave"]
if username and password:
    cmd.extend(["-U", f"{username}%{password}"])
subprocess.run(cmd, check=True)

domain_state = "/etc/ablestack-storage/smb-domain.json"
if os.path.exists(domain_state):
    os.remove(domain_state)

print(json.dumps({"success": True}))
PY

  if command -v systemctl >/dev/null 2>&1; then
    systemctl restart smbd >/dev/null 2>&1 || true
    systemctl restart winbind >/dev/null 2>&1 || true
  fi
}

apply_iscsi_targets() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import subprocess
import sys

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

state_dir = "/etc/ablestack-storage"
os.makedirs(state_dir, exist_ok=True)
with open(os.path.join(state_dir, "iscsi-targets.json"), "w", encoding="utf-8") as state_fp:
    json.dump(payload, state_fp, sort_keys=True, indent=2)

def run_targetcli(*args):
    return subprocess.run(["targetcli", *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

def ok_or_exists(result):
    text = f"{result.stdout}\n{result.stderr}".lower()
    return result.returncode == 0 or "exists" in text or "already" in text

enabled = bool(payload.get("enabled", True))
applied = 0
skipped = 0
if enabled and subprocess.run(["sh", "-c", "command -v targetcli >/dev/null 2>&1"]).returncode == 0:
    for target in payload.get("targets", []):
        if target.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        iqn = target.get("targetName")
        lun = str(target.get("lunOrNamespace") or "0")
        config = target.get("config") or {}
        backing_path = config.get("backingPath")
        if not iqn or not backing_path:
            skipped += 1
            continue
        backstore = f"ablestack-{target.get('uuid')}"
        if not ok_or_exists(run_targetcli("/backstores/block", "create", backstore, backing_path)):
            raise SystemExit(f"failed to create iSCSI backstore {backstore}")
        if not ok_or_exists(run_targetcli("/iscsi", "create", iqn)):
            raise SystemExit(f"failed to create iSCSI target {iqn}")
        run_targetcli(f"/iscsi/{iqn}/tpg1/portals", "delete", "0.0.0.0", "3260")
        listen_ip = payload.get("listenIp") or "0.0.0.0"
        port = str(payload.get("port") or 3260)
        ok_or_exists(run_targetcli(f"/iscsi/{iqn}/tpg1/portals", "create", listen_ip, port))
        ok_or_exists(run_targetcli(f"/iscsi/{iqn}/tpg1/luns", "create", f"/backstores/block/{backstore}", lun))
        for acl in target.get("acls", []):
            if acl.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
                continue
            initiator = acl.get("principal")
            if not initiator:
                continue
            ok_or_exists(run_targetcli(f"/iscsi/{iqn}/tpg1/acls", "create", initiator))
            acl_config = acl.get("config") or {}
            secrets = acl.get("secrets") or {}
            if acl_config.get("chapUsername"):
                run_targetcli(f"/iscsi/{iqn}/tpg1/acls/{initiator}", "set", "auth", f"userid={acl_config.get('chapUsername')}")
            if secrets.get("chapSecret"):
                run_targetcli(f"/iscsi/{iqn}/tpg1/acls/{initiator}", "set", "auth", f"password={secrets.get('chapSecret')}")
            if acl_config.get("mutualChapUsername"):
                run_targetcli(f"/iscsi/{iqn}/tpg1/acls/{initiator}", "set", "auth", f"mutual_userid={acl_config.get('mutualChapUsername')}")
            if secrets.get("mutualChapSecret"):
                run_targetcli(f"/iscsi/{iqn}/tpg1/acls/{initiator}", "set", "auth", f"mutual_password={secrets.get('mutualChapSecret')}")
        applied += 1
    run_targetcli("saveconfig")
else:
    skipped = len(payload.get("targets", []))

print(json.dumps({"success": True, "targets": len(payload.get("targets", [])), "applied": applied, "skipped": skipped}))
PY

  if command -v systemctl >/dev/null 2>&1; then
    systemctl enable --now target >/dev/null 2>&1 || true
    systemctl restart target >/dev/null 2>&1 || true
  fi
}

apply_nvmeof_subsystems() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import subprocess
import sys

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

state_dir = "/etc/ablestack-storage"
os.makedirs(state_dir, exist_ok=True)
with open(os.path.join(state_dir, "nvmeof-subsystems.json"), "w", encoding="utf-8") as state_fp:
    json.dump(payload, state_fp, sort_keys=True, indent=2)

def write_file(path, value):
    with open(path, "w", encoding="utf-8") as fp:
        fp.write(str(value))

def ensure_dir(path):
    os.makedirs(path, exist_ok=True)

enabled = bool(payload.get("enabled", True))
base = "/sys/kernel/config/nvmet"
applied = 0
skipped = 0
if enabled:
    subprocess.run(["modprobe", "nvmet"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["modprobe", "nvmet-tcp"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if enabled and os.path.isdir(base):
    port_id = "1"
    port_dir = os.path.join(base, "ports", port_id)
    ensure_dir(port_dir)
    write_file(os.path.join(port_dir, "addr_trtype"), "tcp")
    write_file(os.path.join(port_dir, "addr_adrfam"), "ipv4")
    write_file(os.path.join(port_dir, "addr_traddr"), payload.get("listenIp") or "0.0.0.0")
    write_file(os.path.join(port_dir, "addr_trsvcid"), payload.get("port") or 4420)

    for subsystem in payload.get("subsystems", []):
        if subsystem.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        nqn = subsystem.get("targetName")
        if not nqn:
            skipped += 1
            continue
        subsystem_dir = os.path.join(base, "subsystems", nqn)
        ensure_dir(subsystem_dir)
        config = subsystem.get("config") or {}
        write_file(os.path.join(subsystem_dir, "attr_allow_any_host"), "1" if config.get("allowAnyHost") else "0")
        for host in subsystem.get("hosts", []):
            host_nqn = host.get("principal")
            if host_nqn:
                ensure_dir(os.path.join(subsystem_dir, "allowed_hosts", host_nqn))
        for namespace in subsystem.get("namespaces", []):
            if namespace.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
                continue
            nsid = str(namespace.get("lunOrNamespace") or "1")
            ns_config = namespace.get("config") or {}
            backing_path = ns_config.get("backingPath")
            if not backing_path:
                skipped += 1
                continue
            ns_dir = os.path.join(subsystem_dir, "namespaces", nsid)
            ensure_dir(ns_dir)
            write_file(os.path.join(ns_dir, "device_path"), backing_path)
            write_file(os.path.join(ns_dir, "enable"), "1")
        link_path = os.path.join(port_dir, "subsystems", nqn)
        if not os.path.exists(link_path):
            os.symlink(subsystem_dir, link_path)
        applied += 1
else:
    skipped = len(payload.get("subsystems", []))

print(json.dumps({"success": True, "subsystems": len(payload.get("subsystems", [])), "applied": applied, "skipped": skipped}))
PY
}

command="${1:-}"
subcommand="${2:-}"
action="${3:-}"
payload="${4:-}"

case "$command" in
  apply)
    payload="${2:-}"
    if [[ -z "$payload" || ! -r "$payload" ]]; then
      emit_error "A readable payload file is required for apply."
      exit 2
    fi
    log_command "$command" "$payload"
    emit_success "Storage Service apply skeleton accepted the payload."
    ;;
  health)
    log_command "$command" ""
    printf '{"success":true,"status":"ok"}\n'
    ;;
  inventory)
    log_command "$command" ""
    printf '{"success":true,"protocols":[],"exports":[],"targets":[]}\n'
    ;;
  nfs)
    if [[ "$subcommand" != "export" || "$action" != "apply" ]]; then
      emit_error "Unsupported nfs operation: ${subcommand:-<empty>} ${action:-<empty>}"
      exit 2
    fi
    if [[ -z "$payload" || ! -r "$payload" ]]; then
      emit_error "A readable payload file is required for nfs export apply."
      exit 2
    fi
    log_command "$command $subcommand $action" "$payload"
    apply_nfs_exports "$payload"
    ;;
  smb)
    if [[ -z "$payload" || ! -r "$payload" ]]; then
      emit_error "A readable payload file is required for smb ${subcommand:-<empty>} ${action:-<empty>}."
      exit 2
    fi
    log_command "$command $subcommand $action" "$payload"
    case "$subcommand $action" in
      "share apply")
        apply_smb_shares "$payload"
        ;;
      "domain join")
        smb_domain_join "$payload"
        ;;
      "domain leave")
        smb_domain_leave "$payload"
        ;;
      *)
        emit_error "Unsupported smb operation: ${subcommand:-<empty>} ${action:-<empty>}"
        exit 2
        ;;
    esac
    ;;
  iscsi)
    if [[ "$subcommand" != "target" || "$action" != "apply" ]]; then
      emit_error "Unsupported iscsi operation: ${subcommand:-<empty>} ${action:-<empty>}"
      exit 2
    fi
    if [[ -z "$payload" || ! -r "$payload" ]]; then
      emit_error "A readable payload file is required for iscsi target apply."
      exit 2
    fi
    log_command "$command $subcommand $action" "$payload"
    apply_iscsi_targets "$payload"
    ;;
  nvmeof)
    if [[ "$subcommand" != "subsystem" || "$action" != "apply" ]]; then
      emit_error "Unsupported nvmeof operation: ${subcommand:-<empty>} ${action:-<empty>}"
      exit 2
    fi
    if [[ -z "$payload" || ! -r "$payload" ]]; then
      emit_error "A readable payload file is required for nvmeof subsystem apply."
      exit 2
    fi
    log_command "$command $subcommand $action" "$payload"
    apply_nvmeof_subsystems "$payload"
    ;;
  *)
    emit_error "Unsupported storagectl command: ${command:-<empty>}"
    exit 2
    ;;
esac
